<project default="build">
	
	<target name="check-fol-grammar">
	    <uptodate property="fol.parser.uptodate"
	              srcfile="grammar/fol.jj"
	              targetfile="src/org/l4cs/fol/parse/FOLParser.java" />
	  </target>

	  <target name="fol-parsegen" depends="check-fol-grammar" unless="fol.parser.uptodate">
	    <mkdir dir="src/org/l4cs/fol/parse"/>
	    <java classname="javacc"
	          classpath="lib/javacc-7.0.13.jar" fork="true">
	      <arg value='-OUTPUT_DIRECTORY="src/org/l4cs/fol/parse"' />
	      <arg value='-STATIC=false' />
	      <arg value='-UNICODE_INPUT=true' />
	      <arg value="grammar/fol.jj" />
	    </java>
	  </target>

	<target name="check-grammar">
		<uptodate property="parser.uptodate"
	      srcfile="grammar/pl.jj"
	      targetfile="src/org/l4cs/pl/parse/PLParser.java" />
	</target>

	<target name="parsegen" depends="check-grammar" unless="parser.uptodate">
		<mkdir dir="src/org/l4cs/pl/parse"/>
		<java classname="javacc"
	  classpath="lib/javacc-7.0.13.jar" fork="true">
			<arg value='-OUTPUT_DIRECTORY="src/org/l4cs/pl/parse"' />
			<arg value='-STATIC=false' />
			<arg value='-UNICODE_INPUT=true' />
			<arg value="grammar/pl.jj" />
		</java>
	</target>

	<target name="compile" depends="parsegen,fol-parsegen">
		<mkdir dir="bin"/>
		<javac destdir="bin" includeantruntime="false">
			<src path="src"/>
			<src path="test"/>
			<classpath path="lib/junit-4.13.2.jar"/>
			<classpath path="lib/hamcrest-core-1.3.jar"/>
		</javac>
	</target>

	<target name="build" depends="compile" />

	<target name="jar" depends="build">
		<jar destfile="lap.jar" basedir="bin" />
	</target>

	<target name="test" depends="build">
		<mkdir dir="junit"/>
		<junit>
			<jvmarg value="-ea" />
			<classpath path="bin" />
			<classpath path="lib/junit-4.13.2.jar"/>
			<classpath path="lib/hamcrest-core-1.3.jar"/>
			<formatter type="brief" usefile="false" />
			<formatter type="xml" />
			<batchtest todir="junit">
				<fileset dir="bin" includes="**/*Test.class" />
			</batchtest>
		</junit>
		<junitreport todir="junit">
			<fileset dir="junit">
				<include name="TEST-*.xml" />
			</fileset>
			<report format="frames" todir="junit">
				<param name="TITLE"
	       expression="JUnit Report for Logic, Algorithms, Proof" />
			</report>
		</junitreport>
	</target>

	<target name="clean">
	    <delete file="lap.jar"/>
	    <delete dir="bin"/>
	    <delete dir="junit"/>
	    <delete dir="src/org/l4cs/pl/parse"/>
	    <delete dir="src/org/l4cs/fol/parse"/> </target>

</project>
